<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:vm="clr-namespace:GpsTrackerPrototype.ViewModels"
            x:Class="GpsTrackerPrototype.Views.TrainingPage"
            Title="Тренировка">

    <Grid RowDefinitions="*,Auto">

        <VerticalStackLayout Padding="30" Spacing="20"
                     HorizontalOptions="Center" VerticalOptions="Center">
            <!--Интерфейс трека-->
            <Label Text="{Binding CurrentSpeedKmHText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            <Label Text="{Binding TotalDistanceMText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            <Label Text="{Binding GpsAccuracyText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            <Label Text="{Binding RecordedPointsText}" FontSize="10" HorizontalOptions="Center" HorizontalTextAlignment="Start"/>
        </VerticalStackLayout>

        <!-- Фиксированный футер -->
        <Border Grid.Row="1"
            StrokeThickness="1"
            Stroke="#E0E0E0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1C}">
            <Grid Padding="12" ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Кнопка "Начать" слева -->
                <Button Grid.Column="0"
                    Text="Закончить"
                    Command="{Binding StopCommand}"
                    HorizontalOptions="Fill"
                    Margin="20,0,10,0"
                    HeightRequest="80"
                    />
            </Grid>
        </Border>

    </Grid>
</ContentPage>