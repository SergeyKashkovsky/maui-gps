<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiGps.ViewModel;assembly=MauiGps"
             x:Class="MauiGps.MainPage"
             x:DataType="vm:MainViewModel">

    <VerticalStackLayout Padding="30" Spacing="20"
                         HorizontalOptions="Center" VerticalOptions="Center">

        <Label Text="{Binding Status}" FontSize="18" FontAttributes="Bold"/>
        <Label Text="{Binding CoarseCoords}" FontSize="16"/>
        <Label Text="{Binding FineCoords}" FontSize="16"/>

        <Button Text="Обновить данные GPS" Command="{Binding CheckGpsCommand}"/>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Лимит скорости (км/ч):" VerticalOptions="Center"/>
            <Entry Text="{Binding MaxSpeedKmH}"
                   Keyboard="Numeric" WidthRequest="60"
                   HorizontalTextAlignment="Center"/>
        </HorizontalStackLayout>

        <Label Text="{Binding CurrentCoords}" FontSize="14"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding Altitude}" FontSize="14"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <Button Text="{Binding TrackButtonText}"
                BackgroundColor="{Binding TrackButtonColor}"
                Command="{Binding ToggleTrackCommand}"
                TextColor="White" FontAttributes="Bold"
                WidthRequest="250" HeightRequest="60"/>
    </VerticalStackLayout>
</ContentPage>