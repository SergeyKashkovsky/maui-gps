<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiGps.ViewModel;assembly=MauiGps"
             x:Class="MauiGps.MainPage"
             x:DataType="vm:MainViewModel">

    <VerticalStackLayout Padding="30" Spacing="20"
                         HorizontalOptions="Center" VerticalOptions="Center">

        <!--Интерфейс трека-->
        <Label Text="{Binding Status}" FontSize="18" FontAttributes="Bold"/>
        <Picker ItemsSource="{Binding SpeedModes}"
            SelectedItem="{Binding SelectedSpeedMode}"
            ItemDisplayBinding="{Binding ., Converter={StaticResource SpeedModeToDisplay}}"
            Title="Выберите режим"
            WidthRequest="200"/>
        <Label Text="{Binding CurrentSpeedKmHText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding TotalDistanceMText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding TotalAscentMText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding TotalDescentMText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding GpsAccuracyText}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding CurrentCoords}" FontSize="14"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        <Label Text="{Binding Altitude}" FontSize="14"
               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        <Button Text="{Binding TrackButtonText}"
                BackgroundColor="{Binding TrackButtonColor}"
                Command="{Binding ToggleTrackCommand}"
                TextColor="White" FontAttributes="Bold"
                WidthRequest="250" HeightRequest="60"/>
        <Button Text="Загрузить трек из файла (.gpx)" 
            Command="{Binding LoadTrackCommand}"
            BackgroundColor="{StaticResource Secondary}"
            TextColor="White"
            FontAttributes="Bold"
            WidthRequest="250" 
            HeightRequest="50"
            Margin="0,10,0,0"/>
    </VerticalStackLayout>
</ContentPage>